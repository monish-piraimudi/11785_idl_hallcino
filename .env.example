ANTHROPIC_API_KEY=
HF_TOKEN=

# Which backend the baseline generates from: anthropic | hf_inference | hf_local
HALLCINO_BACKEND=anthropic

# Model id for the chosen backend, e.g. claude-opus-5 or google/gemma-2-9b-it
HALLCINO_MODEL=claude-opus-5

# Model used as the LLM judge (always Anthropic, regardless of backend under test)
HALLCINO_JUDGE_MODEL=claude-opus-5
